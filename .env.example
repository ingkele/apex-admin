# Apex Admin 环境变量示例 —— 复制为 .env.local（.env* 已被 git 忽略，仅本文件入库）

# 数据模式：mock（默认，内存模拟零后端）| live（真实 axios 请求）
VITE_DATA_MODE=mock

# 后端 API 地址：
# - 开发期推荐保持 /api 相对路径 + vite.config.ts 的 server.proxy 代理（无跨域）
# - 前后端异域直连时才填完整地址，如 https://api.example.com（需后端配 CORS）
VITE_API_BASE_URL=/api

# 请求超时（毫秒，默认 15000）
VITE_API_TIMEOUT=15000
